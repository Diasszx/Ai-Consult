# Provedor de IA ativo ("deepseek" ou "gemini")
LLM_PROVIDER="deepseek"

# Configuração DeepSeek (Obrigatória se LLM_PROVIDER="deepseek")
DEEPSEEK_API_KEY="sk-sua_chave_deepseek_aqui"
DEEPSEEK_MODEL="deepseek-chat"
DEEPSEEK_BASE_URL="https://api.deepseek.com"

# Configuração Google Gemini (Obrigatória se LLM_PROVIDER="gemini")
GEMINI_API_KEY="sua_chave_gemini_aqui"
GEMINI_MODEL="gemini-3.8-flash"
